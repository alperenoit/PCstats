<Window x:Class="PCStatsWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Stats Overlay Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern İnce Progress Bar Stili -->
        <Style x:Key="MetricProgressBar"
                TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="5"/>
            <Setter Property="Minimum"
                    Value="0"/>
            <Setter Property="Maximum"
                    Value="100"/>
            <Setter Property="Background"
                    Value="#28FFFFFF"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot"
                                SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="2.5"/>
                            <Border x:Name="PART_Track"
                                    CornerRadius="2.5"/>
                            <Decorator x:Name="PART_Indicator"
                                    HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="2.5"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Üst Bar İkon Buton Stili -->
        <Style x:Key="HeaderIconButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="#18FFFFFF"/>
            <Setter Property="Foreground"
                    Value="#E0E6ED"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="6,3"/>
            <Setter Property="Margin"
                    Value="3,0,0,0"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="btnBorder"
                                        Property="Background"
                                        Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="btnBorder"
                                        Property="Background"
                                        Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ana Yarı Saydam Çerçeve -->
    <Border x:Name="RootBorder"
            CornerRadius="14"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            Margin="8">
        <Border.Background>
            <SolidColorBrush x:Name="BackgroundBrush"
                    Color="#D80F1319"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                    ShadowDepth="2"
                    Opacity="0.55"
                    Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- ==================== 1. DETAYLI KART MODU (DİKEY WIDGET) ==================== -->
            <StackPanel x:Name="DetailedPanel"
                    Width="295"
                    Margin="14,12,14,12">

                <!-- Üst Başlık ve Kontrol Çubuğu -->
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                Width="8"
                                Height="8"
                                Fill="#00E676"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="PC STATS"
                                FontWeight="Bold"
                                FontSize="12"
                                Foreground="#F0F4F8"
                                VerticalAlignment="Center"/>
                        <Border x:Name="LockBadge"
                                Background="#33FF9800"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock Text="KİLİTLİ (F8)"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#FFB74D"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HeaderButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button x:Name="BtnAdmin"
                                Style="{StaticResource HeaderIconButton}"
                                Content="🛡️ Yönetici"
                                ToolTip="Tüm anakart/sıcaklık sensörleri için Yönetici olarak yeniden başlat"
                                Click="BtnAdmin_Click"
                                Visibility="Collapsed"
                                Foreground="#FFD54F"/>
                        <Button x:Name="BtnCompactMode"
                                Style="{StaticResource HeaderIconButton}"
                                Content="▬"
                                ToolTip="Yatay Oyun Şeridi Moduna Geç (F9)"
                                Click="BtnToggleMode_Click"/>
                        <Button x:Name="BtnLock"
                                Style="{StaticResource HeaderIconButton}"
                                Content="🔓"
                                ToolTip="Tıklama Geçirgenliği / Hayalet Modu (F8)"
                                Click="BtnLock_Click"/>
                        <Button Style="{StaticResource HeaderIconButton}"
                                Content="✕"
                                ToolTip="Kapat"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- ÜST İKİLİ KART: FPS & PING -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FPS Kartı -->
                    <Border Grid.Column="0"
                            Background="#16FFFFFF"
                            CornerRadius="9"
                            Padding="10,8"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="🎮 FPS"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtFpsSource"
                                        Text="Ekran"
                                        FontSize="9.5"
                                        Foreground="#64748B"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Bottom">
                                <TextBlock x:Name="TxtFpsValue"
                                        Text="60"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="#00E676"/>
                                <TextBlock Text=" FPS"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="#94A3B8"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PING Kartı -->
                    <Border Grid.Column="2"
                            Background="#16FFFFFF"
                            CornerRadius="9"
                            Padding="10,8"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonDown="PingCard_MouseLeftButtonDown"
                            ToolTip="Ping sunucusunu değiştirmek için tıklayın">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="🌐 PING"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtPingTarget"
                                        Text="1.1.1.1"
                                        FontSize="9.5"
                                        Foreground="#64748B"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Bottom">
                                <TextBlock x:Name="TxtPingValue"
                                        Text="--"
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="#38BDF8"/>
                                <TextBlock Text=" ms"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="#94A3B8"
                                        VerticalAlignment="Bottom"
                                        Margin="2,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- CPU BÖLÜMÜ (Kullanım % + Sıcaklık °C) -->
                <Border Background="#16FFFFFF"
                        CornerRadius="9"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ CPU"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#38BDF8"/>
                                <TextBlock x:Name="TxtCpuName"
                                        Text=""
                                        FontSize="9.5"
                                        Foreground="#64748B"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        MaxWidth="115"
                                        TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <!-- CPU Kullanım Yüzdesi -->
                                <TextBlock x:Name="TxtCpuUsage"
                                        Text="0%"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#F8FAFC"/>
                                <TextBlock Text="  •  "
                                        FontSize="12"
                                        Foreground="#475569"
                                        VerticalAlignment="Center"/>
                                <!-- CPU Sıcaklığı -->
                                <TextBlock x:Name="TxtCpuTemp"
                                        Text="--°C"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#FBBF24"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="BarCpuUsage"
                                Style="{StaticResource MetricProgressBar}"
                                Value="0"
                                Foreground="#38BDF8"
                                Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- GPU BÖLÜMÜ (Kullanım % + Sıcaklık °C) -->
                <Border Background="#16FFFFFF"
                        CornerRadius="9"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔥 GPU"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#A855F7"/>
                                <TextBlock x:Name="TxtGpuName"
                                        Text=""
                                        FontSize="9.5"
                                        Foreground="#64748B"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        MaxWidth="115"
                                        TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <!-- GPU Kullanım Yüzdesi -->
                                <TextBlock x:Name="TxtGpuUsage"
                                        Text="0%"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#F8FAFC"/>
                                <TextBlock Text="  •  "
                                        FontSize="12"
                                        Foreground="#475569"
                                        VerticalAlignment="Center"/>
                                <!-- GPU Sıcaklığı -->
                                <TextBlock x:Name="TxtGpuTemp"
                                        Text="--°C"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#FBBF24"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="BarGpuUsage"
                                Style="{StaticResource MetricProgressBar}"
                                Value="0"
                                Foreground="#A855F7"
                                Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- FAN HIZI BÖLÜMÜ -->
                <Border Background="#16FFFFFF"
                        CornerRadius="9"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="🌀 FAN HIZI"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#2DD4BF"/>
                            <TextBlock x:Name="TxtFanSpeed"
                                    Text="0 RPM"
                                    FontSize="13.5"
                                    FontWeight="Bold"
                                    Foreground="#F8FAFC"
                                    HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar x:Name="BarFanSpeed"
                                Style="{StaticResource MetricProgressBar}"
                                Value="0"
                                Foreground="#2DD4BF"
                                Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ALT KONTROL PANELİ (Opaklık Ayarı & Kısayol Bilgisi) -->
                <StackPanel x:Name="FooterControlsPanel"
                        Margin="2,2,2,0">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Saydamlık"
                                FontSize="10"
                                Foreground="#94A3B8"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtOpacityVal"
                                Text="85%"
                                FontSize="10"
                                Foreground="#94A3B8"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"/>
                        <Slider x:Name="SliderOpacity"
                                Minimum="0.25"
                                Maximum="1.0"
                                Value="0.85"
                                VerticalAlignment="Center"
                                ValueChanged="SliderOpacity_ValueChanged"/>
                    </DockPanel>
                    <TextBlock Text="F8: Hayalet Modu (Kilit)  •  F9: Mini Bar  •  F10: Gizle"
                               FontSize="9.5"
                            Foreground="#64748B"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0"/>
                </StackPanel>

            </StackPanel>

            <!-- ==================== 2. MİNİ YATAY OYUN ŞERİDİ MODU (HUD BAR) ==================== -->
            <Border x:Name="CompactPanel"
                    Visibility="Collapsed"
                    Padding="12,7">
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <!-- FPS -->
                    <TextBlock Text="FPS "
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#94A3B8"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompactFps"
                            Text="60"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#00E676"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="   |   "
                            Foreground="#334155"
                            VerticalAlignment="Center"/>

                    <!-- CPU -->
                    <TextBlock Text="CPU "
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#38BDF8"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompactCpu"
                            Text="0%  --°C"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#F8FAFC"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="   |   "
                            Foreground="#334155"
                            VerticalAlignment="Center"/>

                    <!-- GPU -->
                    <TextBlock Text="GPU "
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#A855F7"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompactGpu"
                            Text="0%  --°C"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#F8FAFC"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="   |   "
                            Foreground="#334155"
                            VerticalAlignment="Center"/>

                    <!-- FAN -->
                    <TextBlock Text="FAN "
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#2DD4BF"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompactFan"
                            Text="0 RPM"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#F8FAFC"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="   |   "
                            Foreground="#334155"
                            VerticalAlignment="Center"/>

                    <!-- PING -->
                    <TextBlock Text="PING "
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#94A3B8"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCompactPing"
                            Text="-- ms"
                            FontSize="12.5"
                            FontWeight="Bold"
                            Foreground="#38BDF8"
                            VerticalAlignment="Center"/>

                    <!-- Mini Kontroller -->
                    <StackPanel x:Name="CompactButtonsPanel"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">
                        <Button Style="{StaticResource HeaderIconButton}"
                                Content="▤"
                                ToolTip="Detaylı Görünüme Dön (F9)"
                                Click="BtnToggleMode_Click"/>
                        <Button Style="{StaticResource HeaderIconButton}"
                                Content="🔓"
                                ToolTip="Hayalet Modu (F8)"
                                Click="BtnLock_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
